    st.rerun()

# 6. 구글 시트 / 엑셀 데이터 통합 로딩 함수
@st.cache_data(ttl=10)
def load_all_workbook_data(url, file):
    cs_sheets_dict = {}
    df_res_all = pd.DataFrame()
    df_c_all = pd.DataFrame()
    available_cs_sheets = []

    try:
        if file is not None:
            xls = pd.ExcelFile(file)
            for sheet in xls.sheet_names:
                df = pd.read_excel(xls, sheet_name=sheet)
                cs_sheets_dict[sheet] = df.fillna("")
                available_cs_sheets.append(sheet)
        elif url:
            match = re.search(r'/d/([a-zA-Z0-9-_]+)', url)
            if match:
                spreadsheet_id = match.group(1)
                export_url = f"https://docs.google.com/spreadsheets/d/{spreadsheet_id}/export?format=xlsx"
                res = requests.get(export_url)
                if res.status_code == 200:
                    xls = pd.ExcelFile(io.BytesIO(res.content))
                    for sheet in xls.sheet_names:
                        df = pd.read_excel(xls, sheet_name=sheet)
                        cs_sheets_dict[sheet] = df.fillna("")
                        available_cs_sheets.append(sheet)
    except Exception as e:
        st.error(f"데이터를 불러오는 중 오류가 발생했습니다: {e}")

    return cs_sheets_dict, df_res_all, df_c_all, available_cs_sheets

# 데이터 수집 실행
cs_sheets_dict, df_res_all, df_c_all, available_cs_sheets = load_all_workbook_data(gsheet_url, uploaded_file)

